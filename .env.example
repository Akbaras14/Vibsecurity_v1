# Frontend Next.js. Ubah sebelum npm run build jika port API berbeda.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Backend Python memuat .env.local; environment proses lebih diutamakan.
# Default storage: storage/vibesec; default origin frontend: localhost/127.0.0.1:3000.
# VIBESEC_STORAGE=
# VIBESEC_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# VIBESEC_HOSTS=127.0.0.1,localhost
# VIBESEC_SEMGREP=semgrep
# VIBESEC_OSV_SCANNER=/absolute/path/to/osv-scanner_linux_amd64
# VIBESEC_OSV_CACHE=/absolute/path/to/storage/osv
# VIBESEC_MEMORY_CGROUP=/sys/fs/cgroup/memory/vibesec-scanner
# VIBESEC_NETWORK_CGROUP=/sys/fs/cgroup/net_cls/vibesec-scanner
# Aktifkan hanya setelah setup host Linux/WSL dan firewall diuji; lihat README.
# VIBESEC_SCANNER_HOST_READY=1

# Database MySQL untuk backend Python; bukan login aplikasi.
VIBESEC_MYSQL_HOST=127.0.0.1
VIBESEC_MYSQL_PORT=3308
VIBESEC_MYSQL_DATABASE=vibesec
VIBESEC_MYSQL_USER=vibesec_api
VIBESEC_MYSQL_PASSWORD=
